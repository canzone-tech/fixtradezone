        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Admin - Reconcile due financial trades",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/subscriptions/{{subscriptionId}}/reconcile-trades",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('createdEvents is valid', () => pm.expect(Number(b.createdEvents)).to.be.at.least(0));",
              "pm.test('createdSettlements is valid', () => pm.expect(Number(b.createdSettlements)).to.be.at.least(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Admin - Immutable trade history + principal formula",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/subscriptions/{{subscriptionId}}/events?page=1&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const rows = b.events || [];",
              "pm.collectionVariables.set('eventCountAfterFirst', String(b.total || rows.length));",
              "pm.test('At least one due trade exists', () => pm.expect(rows.length).to.be.above(0));",
              "const keys = rows.map(x => `${x.localTradeDate}:${x.slotNumber}`);",
              "pm.test('No duplicate date/slot events', () => pm.expect(new Set(keys).size).to.eql(keys.length));",
              "const principal = Number(pm.collectionVariables.get('principalAmount'));",
              "for (const e of rows) {",
              "  if (e.eventType === 'NORMAL') {",
              "    const expected = Number((principal * Number(e.resultPercent) / 100).toFixed(8));",
              "    pm.expect(Number(e.grossResultAmount)).to.be.closeTo(expected, 0.00000002);",
              "  }",
              "  pm.expect(Number(e.userShareAmount) + Number(e.adminShareAmount)).to.be.closeTo(Number(e.grossSettlementAmount), 0.00000002);",
              "}",
              "const posted = rows.find(x => x.ledgerTransactionId);",
              "pm.test('At least one high-water financial settlement exists', () => pm.expect(posted, 'No WIN has crossed the high-water yet').to.exist);",
              "if (posted) pm.collectionVariables.set('ledgerTransactionId', posted.ledgerTransactionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Admin - Settlement ledger is balanced 3-leg accounting",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/ledger/{{ledgerTransactionId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ledger transaction exists', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Ledger reports balanced', () => pm.expect(b.balanced).to.eql(true));",
              "pm.test('Correct ledger kind', () => pm.expect(b.transaction.kind).to.eql('INTERNAL_TRADING_SETTLEMENT'));",
              "const entries = b.entries || [];",
              "const debits = entries.filter(x => x.side === 'DEBIT').reduce((a,x) => a + Number(x.amount), 0);",
              "const credits = entries.filter(x => x.side === 'CREDIT').reduce((a,x) => a + Number(x.amount), 0);",
              "pm.test('Debit equals credit', () => pm.expect(debits).to.be.closeTo(credits, 0.00000002));",
              "const buckets = entries.map(x => x.bucket);",
              "pm.test('Return expense debit exists', () => pm.expect(buckets).to.include('INTERNAL_TRADING_RETURN_EXPENSE'));",
              "pm.test('USER package earning credit exists', () => pm.expect(buckets).to.include('PACKAGE_EARNINGS'));",
              "pm.test('Admin profit credit exists', () => pm.expect(buckets).to.include('INTERNAL_TRADING_ADMIN_PROFIT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Admin - Reconcile same due trades again (idempotency)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/subscriptions/{{subscriptionId}}/reconcile-trades",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('No duplicate events', () => pm.expect(Number(b.createdEvents)).to.eql(0));",
              "pm.test('No duplicate settlements', () => pm.expect(Number(b.createdSettlements)).to.eql(0));"
            ]
          }
        }
      ]
    },
