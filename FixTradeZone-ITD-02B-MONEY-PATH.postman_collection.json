      "value": ""
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "depositId",
      "value": ""
    },
    {
      "key": "depositUserId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "principalAmount",
      "value": ""
