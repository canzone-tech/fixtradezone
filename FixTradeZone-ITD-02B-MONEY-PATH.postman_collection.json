      "value": "0"
    },
    {
      "key": "ledgerTransactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Admin - Effective ITD policy",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/policies",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const p = (b.policies || []).find(x => x.status === 'PUBLISHED' && x.enabled === true);",
              "pm.test('Enabled published policy exists', () => pm.expect(p).to.exist);",
              "if (p) {",
              "  pm.expect(Number(p.activitiesPerDay)).to.be.at.least(5);",
              "  pm.expect(Number(p.userSharePercent) + Number(p.adminSharePercent)).to.eql(100);",
              "  pm.collectionVariables.set('publishedPolicyId', p.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Admin - Find fresh activation pending deposit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/subscriptions/activation-pending?page=1&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const rows = b.deposits || [];",
              "let id = pm.collectionVariables.get('depositId');",
              "let row = id ? rows.find(x => x.depositId === id) : rows[0];",
              "if (!id && row) {",
              "  id = row.depositId;",
              "  pm.collectionVariables.set('depositId', id);",
              "}",
              "if (row) pm.collectionVariables.set('depositUserId', row.userId);",
              "pm.test('Fresh activation-pending deposit selected', () => {",
              "  pm.expect(id, 'Set depositId manually if no pending deposit exists').to.be.ok;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Admin - Activate fresh package",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/admin/deposits/{{depositId}}/activate-package",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activation success', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const b = pm.response.json();",
              "pm.test('Fresh activation created', () => pm.expect(b.created).to.eql(true));",
              "pm.test('Subscription returned', () => pm.expect(b.subscription && b.subscription.id).to.be.ok);",
              "if (b.subscription) {",
              "  pm.collectionVariables.set('subscriptionId', b.subscription.id);",
              "  const expectedUser = pm.collectionVariables.get('depositUserId');",
              "  if (expectedUser) pm.expect(b.subscription.userId).to.eql(expectedUser);",
              "  if ('earningAuthority' in b.subscription) {",
              "    pm.test('ITD owns new subscription earnings', () => pm.expect(b.subscription.earningAuthority).to.eql('INTERNAL_TRADING'));",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Admin - New package appears in ITD workspace",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/workspace?page=1&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const id = pm.collectionVariables.get('subscriptionId');",
              "const s = (b.states || []).find(x => x.subscriptionId === id);",
              "pm.test('ITD state exists', () => pm.expect(s).to.exist);",
              "if (s) {",
              "  pm.collectionVariables.set('principalAmount', s.principalAmount);",
              "  pm.test('Package active', () => pm.expect(s.status).to.eql('ACTIVE'));",
              "  pm.test('Split totals 100%', () => pm.expect(Number(s.userSharePercent) + Number(s.adminSharePercent)).to.eql(100));",
              "  pm.test('Initial high-water valid', () => pm.expect(Number(s.grossHighWaterMark)).to.be.at.least(0));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Admin - Reconcile lifecycle state",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/admin/internal-trading/subscriptions/{{subscriptionId}}/reconcile-state",
