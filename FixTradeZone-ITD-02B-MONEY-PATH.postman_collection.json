      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const before = Number(pm.collectionVariables.get('eventCountAfterFirst'));",
              "pm.test('Immutable event count unchanged', () => pm.expect(Number(b.total)).to.eql(before));"
            ]
          }
        }
      ]
    },
