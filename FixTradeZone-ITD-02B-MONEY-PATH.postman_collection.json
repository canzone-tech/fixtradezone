{
  "info": {
    "name": "FixTradeZone ITD-02B LOCAL MONEY-PATH ACCEPTANCE",
    "_postman_id": "0a326412-1f46-49e8-87c2-itd02b",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local-only ITD-02B acceptance. Fresh activation -> state -> due trades -> immutable events -> 3-leg ledger -> idempotency -> USER privacy/readback."
