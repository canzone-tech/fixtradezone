    {
      "name": "12 USER - Own trade history + privacy",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/internal-trading/me/packages/{{subscriptionId}}/events?page=1&limit=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userAccessToken}}",
              "type": "string"
            }
          ]
