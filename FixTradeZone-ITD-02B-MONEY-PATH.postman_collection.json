        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('USER event history exists', () => pm.expect((b.events || []).length).to.be.above(0));",
              "for (const e of (b.events || [])) {",
              "  pm.expect(e).to.not.have.property('adminShareAmount');",
              "  pm.expect(e).to.not.have.property('ledgerTransactionId');",
              "  pm.expect(e).to.not.have.property('generatedByUserId');",
              "  pm.expect(e).to.not.have.property('sourceKey');",
              "}"
            ]
          }
        }
      ]
    },
