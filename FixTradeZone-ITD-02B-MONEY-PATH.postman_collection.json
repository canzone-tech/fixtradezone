      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/internal-trading/me/packages",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const id = pm.collectionVariables.get('subscriptionId');",
              "const s = (b.packages || []).find(x => x.subscriptionId === id);",
              "pm.test('USER owns activated package', () => pm.expect(s, 'Use USER token for the deposit owner').to.exist);",
              "if (s) {",
              "  pm.test('USER credited earnings visible', () => pm.expect(s.userCreditedAmount).to.exist);",
              "  pm.test('Admin recognized amount hidden', () => pm.expect(s).to.not.have.property('adminRecognizedAmount'));",
              "  pm.test('Admin split hidden', () => pm.expect(s).to.not.have.property('adminSharePercent'));",
              "}"
