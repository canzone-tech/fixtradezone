# Copy this file to backend/.env for local development.
# Replace every REPLACE_ME value. Never commit backend/.env.

NODE_ENV=development
PORT=3000

# Prisma CLI connection URL. URL-encode reserved characters in the password.
DATABASE_URL=mysql://fixtradezone:REPLACE_ME_MYSQL_PASSWORD@127.0.0.1:3306/fixtradezone

# NestJS runtime connection settings used by the MariaDB adapter.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fixtradezone
MYSQL_USER=fixtradezone
MYSQL_PASSWORD=REPLACE_ME_MYSQL_PASSWORD

MONGODB_URI=mongodb://127.0.0.1:27017/fixtradezone

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# RWD-01 due-reward worker is an explicit financial opt-in. Keep it disabled
# during local/manual acceptance and initial deployment. Enable only after the
# scheduled reward settlement gate is accepted. Redis lock plus immutable
# ledger/event source keys remain authoritative for duplicate protection.
REWARD_WORKER_ENABLED=false
REWARD_WORKER_INTERVAL_MS=60000

CAPTCHA_HMAC_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Generate independent cryptographically random values of at least 32 characters.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_32_RANDOM_CHARACTERS

