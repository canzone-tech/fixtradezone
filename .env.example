# Copy this file to backend/.env for local development.
# Replace every REPLACE_ME value. Never commit backend/.env.
# FixTradeZone persistent relational/accounting storage is MySQL only.

NODE_ENV=development
PORT=3000

# Prisma CLI connection URL. URL-encode reserved characters in the password.
DATABASE_URL=mysql://fixtradezone:REPLACE_ME_MYSQL_PASSWORD@127.0.0.1:3306/fixtradezone

# NestJS runtime connection settings used by the MariaDB adapter.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fixtradezone
MYSQL_USER=fixtradezone
MYSQL_PASSWORD=REPLACE_ME_MYSQL_PASSWORD

# Redis is required for CAPTCHA/session-supporting flows, email verification,
# password-reset tokens and worker locks.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Public frontend origin used in verification/reset email links.
# Production startup requires a public HTTPS URL (not localhost).
PUBLIC_APP_URL=https://localhost:3001

# Email transport. Local development defaults to CONSOLE. Production startup
# rejects CONSOLE and requires HTTP or SMTP delivery.
COMMUNICATION_EMAIL_MODE=CONSOLE
COMMUNICATION_EMAIL_FROM=no-reply@fixtradezone.local
COMMUNICATION_EMAIL_TIMEOUT_MS=10000

# HTTP email transport (used only when COMMUNICATION_EMAIL_MODE=HTTP).
COMMUNICATION_EMAIL_HTTP_URL=
COMMUNICATION_EMAIL_HTTP_BEARER_TOKEN=

# Direct SMTP transport (used only when COMMUNICATION_EMAIL_MODE=SMTP).
# 587 + SMTP_SECURE=false + SMTP_REQUIRE_TLS=true = STARTTLS.
# 465 + SMTP_SECURE=true = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FixTradeZone

EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# RWD-01 due-reward worker is an explicit financial opt-in. Keep it disabled
# during local/manual acceptance and initial deployment. Enable only after the
# scheduled reward settlement gate is accepted.
REWARD_WORKER_ENABLED=false
REWARD_WORKER_INTERVAL_MS=60000

# SIM-01 display-only activity worker is explicit opt-in. Automatic generation
# also requires Platform Operations mode AUTOMATIC. It never posts money.
SIMULATED_ACTIVITY_WORKER_ENABLED=false
SIMULATED_ACTIVITY_WORKER_INTERVAL_MS=60000

# Internal trading lifecycle worker is explicit opt-in and remains OFF during
# manual acceptance. Operations policy remains authoritative.
INTERNAL_TRADING_WORKER_ENABLED=false
INTERNAL_TRADING_WORKER_INTERVAL_MS=60000
INTERNAL_TRADING_WORKER_BATCH_SIZE=100

CAPTCHA_HMAC_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Generate independent cryptographically random values of at least 32 characters.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_32_RANDOM_CHARACTERS
