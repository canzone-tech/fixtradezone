NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/fixtradezone
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fixtradezone
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Deposit blockchain verification uses the official public BSC RPC when this is blank.
# Production may override this with a dedicated HTTPS BSC RPC provider URL.
DEPOSIT_BSC_RPC_URL=
DEPOSIT_BSC_RPC_TIMEOUT_MS=8000

# Team Business Awards processing is automatic when Operations mode is AUTOMATIC.
# Set AWARD_REWARD_WORKER_ENABLED=false only for an explicit maintenance/emergency pause.
AWARD_REWARD_WORKER_ENABLED=true
AWARD_REWARD_WORKER_INTERVAL_MS=60000

PUBLIC_APP_URL=https://localhost:3001
COMMUNICATION_EMAIL_MODE=CONSOLE
COMMUNICATION_EMAIL_FROM=no-reply@fixtradezone.local
COMMUNICATION_EMAIL_HTTP_URL=
COMMUNICATION_EMAIL_HTTP_BEARER_TOKEN=
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

CAPTCHA_HMAC_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
