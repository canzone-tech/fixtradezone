{
  "info": {
    "_postman_id": "4d802b5d-8ae8-4ae9-a2c7-5ac8d7eab202",
    "name": "FixTradeZone DEP-02 Package Account Routing",
    "description": "LOCAL ACCEPTANCE ONLY. Run after migration 0034_package_deposit_account_routing is deployed. Proves package-bound receiving-account creation is atomic, one configured receiving account resolves per package, USER deposit context exposes that configured route before payment submission, and a one-step deposit enters PENDING_REVIEW with immutable routing snapshots. Before running, set depositReceivingAddress and depositQrDataUrl to the REAL local-test receiving address and its matching QR data URL for the active payment rail. Optionally set depositNetworkCode (for example BEP20) and depositPackageCode. The collection deliberately chooses a package that is AVAILABLE, has no route yet, and is not already ACTIVE for the test user. The created package account/route is intentional configuration and is not deleted; only the synthetic QA deposit is rejected at the end so no accounting or package activation occurs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "depositNetworkCode", "value": "" },
    { "key": "depositPackageCode", "value": "" },
    { "key": "depositReceivingAddress", "value": "" },
    { "key": "depositQrDataUrl", "value": "" }
  ],
  "item": [
    {
      "name": "01 Admin Login",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('admin login 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
          "pm.expect(body.user.roles).to.include.oneOf(['ADMIN', 'SUPER_ADMIN']);",
          "pm.environment.set('adminAccessToken', body.accessToken);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"identifier\": \"{{adminIdentifier}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "02 User Login",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('user login 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
          "pm.expect(body.user.roles).to.include('USER');",
          "pm.environment.set('userAccessToken', body.accessToken);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"identifier\": \"{{userIdentifier}}\",\n  \"password\": \"{{userPassword}}\"\n}"},
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "03 User Active Package Readback",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('subscriptions 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const activeCodes = (body.active || []).map(item => item.packageCode);",
          "pm.environment.set('depositActivePackageCodesJson', JSON.stringify(activeCodes));"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}],
        "url": "{{baseUrl}}/subscriptions/me?limit=100"
      }
    },
    {
      "name": "04 Select Unconfigured Package Route",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('package route list 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const activeCodes = JSON.parse(pm.environment.get('depositActivePackageCodesJson') || '[]');",
          "const preferredCode = (pm.variables.get('depositPackageCode') || pm.environment.get('depositPackageCode') || '').trim();",
          "const eligible = (body.packages || []).filter(p => p.availability === 'AVAILABLE' && !p.depositAccountId && !activeCodes.includes(p.packageCode));",
          "const item = preferredCode ? eligible.find(p => p.packageCode === preferredCode) : eligible[0];",
          "pm.test('eligible unconfigured non-active package exists', () => pm.expect(item, preferredCode ? `Package ${preferredCode} must be AVAILABLE, unconfigured and not ACTIVE for the QA user` : 'Need one AVAILABLE package with no receiving route that is not ACTIVE for the QA user').to.exist);",
          "if (item) {",
          "  pm.environment.set('depositPackageItemId', item.packagePlanItemId);",
          "  pm.environment.set('depositPackageDefinitionId', item.packageDefinitionId);",
          "  pm.environment.set('depositPackageSelectedCode', item.packageCode);",
          "  pm.environment.set('depositPackageDisplayName', item.displayName);",
          "  pm.environment.set('depositPackageCurrency', item.currency);",
          "}"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}],
        "url": "{{baseUrl}}/admin/deposit-package-accounts"
      }
    },
    {
      "name": "05 Select Active Payment Rail",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('payment rail list 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const currency = pm.environment.get('depositPackageCurrency');",
          "const preferredNetwork = (pm.variables.get('depositNetworkCode') || pm.environment.get('depositNetworkCode') || '').trim().toUpperCase();",
          "const eligible = (body.rails || []).filter(r => r.isActive && r.asset === currency);",
          "const rail = preferredNetwork ? eligible.find(r => r.networkCode === preferredNetwork) : eligible[0];",
          "pm.test('eligible active payment rail exists', () => pm.expect(rail, preferredNetwork ? `Active ${currency}/${preferredNetwork} payment rail is required` : `An active ${currency} payment rail is required`).to.exist);",
          "if (rail) {",
          "  pm.environment.set('depositPaymentRailId', rail.id);",
          "  pm.environment.set('depositAccountNetwork', rail.networkCode);",
          "  pm.environment.set('depositValidationProfile', rail.validationProfile);",
          "}"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}],
        "url": "{{baseUrl}}/admin/deposit-payment-rails"
      }
    },
    {
      "name": "06 Create Package Receiving Account Atomically",
      "event": [
        {
          "listen": "prerequest",
          "script": {"exec": [
            "const address = (pm.variables.get('depositReceivingAddress') || pm.environment.get('depositReceivingAddress') || '').trim();",
            "const qr = (pm.variables.get('depositQrDataUrl') || pm.environment.get('depositQrDataUrl') || '').trim();",
            "if (!address) throw new Error('Set depositReceivingAddress to the real local-test receiving address for the selected payment rail before running DEP-02.');",
            "if (!qr.startsWith('data:image/')) throw new Error('Set depositQrDataUrl to the matching QR base64 data URL before running DEP-02.');",
            "pm.environment.set('depositAccountAddress', address);",
            "pm.environment.set('depositAccountQrDataUrl', qr);"
          ]}
        },
        {
          "listen": "test",
          "script": {"exec": [
            "pm.test('atomic package account create 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.expect(body.packageDefinitionId).to.eql(pm.environment.get('depositPackageDefinitionId'));",
            "pm.expect(body.depositAccountId).to.be.a('string').and.not.empty;",
            "pm.expect(body.account.id).to.eql(body.depositAccountId);",
            "pm.expect(body.account.label).to.eql(pm.environment.get('depositPackageDisplayName'));",
            "pm.expect(body.account.paymentRailId).to.eql(pm.environment.get('depositPaymentRailId'));",
            "pm.expect(body.account.walletAddress).to.eql(pm.environment.get('depositAccountAddress'));",
            "pm.expect(body.account.isActive).to.eql(true);",
            "pm.environment.set('depositAccountId', body.depositAccountId);",
            "pm.environment.set('depositAccountNetwork', body.account.network);",
            "pm.environment.set('depositValidationProfile', body.account.paymentRail.validationProfile);"
          ]}
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminAccessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"packageDefinitionId\": \"{{depositPackageDefinitionId}}\",\n  \"paymentRailId\": \"{{depositPaymentRailId}}\",\n  \"walletAddress\": \"{{depositAccountAddress}}\",\n  \"qrCodeDataUrl\": \"{{depositAccountQrDataUrl}}\",\n  \"reason\": \"LOCAL QA DEP-02 atomic package account configuration\"\n}"},
        "url": "{{baseUrl}}/admin/deposit-package-accounts"
      }
    },
    {
      "name": "07 Package Route Readback",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('route readback 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const row = (body.packages || []).find(p => p.packageDefinitionId === pm.environment.get('depositPackageDefinitionId'));",
          "pm.test('package has exactly the atomically created account', () => {",
          "  pm.expect(row).to.exist;",
          "  pm.expect(row.depositAccountId).to.eql(pm.environment.get('depositAccountId'));",
          "});"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminAccessToken}}"}],
        "url": "{{baseUrl}}/admin/deposit-package-accounts"
      }
    },
    {
      "name": "08 User Package Deposit Context",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('package deposit context 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.expect(body.package.id).to.eql(pm.environment.get('depositPackageItemId'));",
          "pm.expect(body.receivingAccount.id).to.eql(pm.environment.get('depositAccountId'));",
          "pm.expect(body.receivingAccount.walletAddress).to.eql(pm.environment.get('depositAccountAddress'));",
          "pm.expect(body.receivingAccount.network).to.eql(pm.environment.get('depositAccountNetwork'));",
          "pm.expect(body.receivingAccount.validationProfile).to.eql(pm.environment.get('depositValidationProfile'));",
          "pm.test('no pre-existing open deposit', () => pm.expect(body.openDeposit).to.eql(null));",
          "const minimum = body.package.minimumInvestment || body.package.price;",
          "pm.environment.set('depositInvestmentAmount', minimum);"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}],
        "url": "{{baseUrl}}/deposits/context/{{depositPackageItemId}}"
      }
    },
    {
      "name": "09 Submit Package Deposit One Step",
      "event": [
        {
          "listen": "prerequest",
          "script": {"exec": [
            "const profile = pm.environment.get('depositValidationProfile');",
            "if (profile === 'SOLANA') {",
            "  const chars = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';",
            "  let value = '';",
            "  for (let i = 0; i < 88; i += 1) value += chars[Math.floor(Math.random() * chars.length)];",
            "  pm.environment.set('depositTxid', value);",
            "} else {",
            "  const chars = '0123456789abcdef';",
            "  let value = '';",
            "  for (let i = 0; i < 64; i += 1) value += chars[Math.floor(Math.random() * chars.length)];",
            "  pm.environment.set('depositTxid', value);",
            "}"
          ]}
        },
        {
          "listen": "test",
          "script": {"exec": [
            "pm.test('single-step submit 201', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().deposit;",
            "pm.expect(d.status).to.eql('PENDING_REVIEW');",
            "pm.expect(d.packagePlanItemId).to.eql(pm.environment.get('depositPackageItemId'));",
            "pm.expect(d.assignedDepositAccountId).to.eql(pm.environment.get('depositAccountId'));",
            "pm.expect(d.assignedWalletAddress).to.eql(pm.environment.get('depositAccountAddress'));",
            "pm.expect(d.assignedNetwork).to.eql(pm.environment.get('depositAccountNetwork'));",
            "pm.expect(d.txid).to.eql(pm.environment.get('depositTxid').toLowerCase());",
            "pm.environment.set('depositId', d.id);"
          ]}
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{userAccessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"packagePlanItemId\": \"{{depositPackageItemId}}\",\n  \"investmentAmount\": \"{{depositInvestmentAmount}}\",\n  \"txid\": \"{{depositTxid}}\"\n}"},
        "url": "{{baseUrl}}/deposits/submit"
      }
    },
    {
      "name": "10 User Deposit Snapshot Readback",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('history 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const d = (body.deposits || []).find(x => x.id === pm.environment.get('depositId'));",
          "pm.test('routing snapshot persisted', () => {",
          "  pm.expect(d).to.exist;",
          "  pm.expect(d.status).to.eql('PENDING_REVIEW');",
          "  pm.expect(d.assignedDepositAccountId).to.eql(pm.environment.get('depositAccountId'));",
          "  pm.expect(d.assignedWalletAddress).to.eql(pm.environment.get('depositAccountAddress'));",
          "  pm.expect(d.assignedNetwork).to.eql(pm.environment.get('depositAccountNetwork'));",
          "});"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}],
        "url": "{{baseUrl}}/deposits/me"
      }
    },
    {
      "name": "11 Admin Reject Local QA Deposit",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('reject 201', () => pm.response.to.have.status(201));",
          "const d = pm.response.json().deposit;",
          "pm.expect(d.status).to.eql('REJECTED');"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminAccessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"note\": \"LOCAL QA DEP-02 cleanup rejection - no accounting expected\"\n}"},
        "url": "{{baseUrl}}/admin/deposits/{{depositId}}/reject"
      }
    },
    {
      "name": "12 Final Rejected Readback",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('final history 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "const d = (body.deposits || []).find(x => x.id === pm.environment.get('depositId'));",
          "pm.test('local QA deposit is rejected', () => {",
          "  pm.expect(d).to.exist;",
          "  pm.expect(d.status).to.eql('REJECTED');",
          "});"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}],
        "url": "{{baseUrl}}/deposits/me"
      }
    }
  ]
}
