{
  "info": {
    "_postman_id": "84f9c23e-dab1-4149-9000-414bf1e98a56",
    "name": "FixTradeZone API",
    "description": "Local verification collection. Select the FixTradeZone Local environment and set testEmail/testPassword before running auth requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('MySQL is up', function () {",
              "  pm.expect(pm.response.json().services.mysql).to.eql('up');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register founder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"username\": \"founder.admin\",\n  \"firstName\": \"Prashant\",\n  \"lastName\": \"Shukla\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration is created or already exists', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.test('Registration response never exposes a password', function () {",
                  "    const body = JSON.stringify(pm.response.json());",
                  "    pm.expect(body).not.to.include('passwordHash');",
                  "    pm.expect(body).not.to.include(pm.environment.get('testPassword'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Token pair and active user are returned', function () {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expiresIn).to.eql(900);",
                  "  pm.expect(body.refreshExpiresIn).to.eql(604800);",
                  "  pm.expect(body.user.status).to.eql('ACTIVE');",
                  "  pm.expect(body.user.roles).to.include('ADMIN');",
                  "});",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Current user returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Current identity matches the environment', function () {",
                  "  const user = pm.response.json().user;",
                  "  pm.expect(user.email).to.eql(pm.environment.get('testEmail').trim().toLowerCase());",
                  "  pm.expect(user.status).to.eql('ACTIVE');",
                  "  pm.expect(user.roles).to.include('ADMIN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh and rotate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('previousRefreshToken', pm.environment.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Refresh token rotates', function () {",
                  "  pm.expect(body.refreshToken).not.to.eql(pm.environment.get('previousRefreshToken'));",
                  "});",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('loggedOutRefreshToken', pm.environment.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.environment.unset('accessToken');",
                  "pm.environment.unset('refreshToken');"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after logout is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{loggedOutRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Revoked refresh token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security checks",
      "item": [
        {
          "name": "Rotated refresh token reuse is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{previousRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reused refresh token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.environment.unset('accessToken');",
                  "pm.environment.unset('refreshToken');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
