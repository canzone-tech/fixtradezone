/* ===== LOGIN BULL EDGE + ZINDEX FINAL LOCK ===== */

/*
 * Exact approved SVG.
 * Size stays locked.
 * Fixes:
 * - hard rectangular left/right edges
 * - bull appearing below decorative lines
 * - dull visual depth
 */

.ftz-auth-bull {
  position: relative !important;
  z-index: 20 !important;
  isolation: isolate !important;

  overflow: visible !important;

  /* Bull is now rendered by ::before */
  background-image: none !important;

  filter: none !important;
  opacity: 1 !important;
}


/* Soft glow BEHIND bull */
.ftz-auth-bull::after {
  content: "" !important;

  position: absolute !important;
  inset: 14% 8% 10% 8% !important;

  z-index: 0 !important;

  background:
    radial-gradient(
      ellipse at center,
      rgba(16, 225, 215, .18) 0%,
      rgba(69, 82, 255, .12) 42%,
      rgba(120, 52, 255, .09) 58%,
      transparent 76%
    ) !important;

  filter: blur(28px) !important;

  opacity: .9 !important;

  pointer-events: none !important;
}


/* Approved bull artwork ABOVE all decorative lines */
.ftz-auth-bull::before {
  content: "" !important;

  position: absolute !important;

  /*
   * Keeps the current approved size.
   * Slight overflow avoids visible box boundaries.
   */
  inset:
    -4%
    -8%
    -4%
    -8% !important;

  z-index: 5 !important;

  background:
    url("/assets/fixtradezone/svg/login-bull-approved.svg")
    center center / contain no-repeat !important;

  opacity: 1 !important;

  /*
   * Feather the rectangular artwork edges
   * so no vertical left/right lines are visible.
   */
  -webkit-mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      rgba(0,0,0,.35) 5%,
      #000 13%,
      #000 87%,
      rgba(0,0,0,.35) 95%,
      transparent 100%
    ) !important;

  mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      rgba(0,0,0,.35) 5%,
      #000 13%,
      #000 87%,
      rgba(0,0,0,.35) 95%,
      transparent 100%
    ) !important;

  filter:
    brightness(1.13)
    contrast(1.08)
    saturate(1.14)
    drop-shadow(
      0 0 18px rgba(19, 229, 216, .20)
    )
    drop-shadow(
      0 0 30px rgba(107, 65, 255, .16)
    ) !important;

  pointer-events: none !important;
}


