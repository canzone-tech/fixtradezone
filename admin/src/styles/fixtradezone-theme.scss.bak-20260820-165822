/*
 * FixTradeZone Dark Neo — MASTER THEME
 * Single global theme authority for:
 * Admin / SUPER_ADMIN / User backend / Auth.
 */


/* ===== migrated from fixtradezone-admin.scss ===== */

:root {
  --ftz-bg: #020817;
  --ftz-bg-2: #050c1f;
  --ftz-panel: rgba(6, 18, 42, 0.88);
  --ftz-panel-2: rgba(8, 23, 53, 0.93);
  --ftz-line: rgba(74, 129, 206, 0.28);
  --ftz-line-bright: rgba(53, 238, 255, 0.48);
  --ftz-text: #f5f8ff;
  --ftz-muted: #8797b5;
  --ftz-cyan: #16e5e0;
  --ftz-green: #14e59a;
  --ftz-blue: #3478ff;
  --ftz-purple: #9d42ff;
  --ftz-magenta: #f03adf;
  --ftz-orange: #ff9e00;
  --ftz-red: #ff5c72;
  --ftz-sidebar: 264px;
  --ftz-topbar: 75px;
}

* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
  background: var(--ftz-bg);
}

body {
  margin: 0;
  color: var(--ftz-text);
  background:
    radial-gradient(circle at 78% 2%, rgba(23, 48, 123, 0.16), transparent 26rem),
    radial-gradient(circle at 34% 70%, rgba(37, 20, 135, 0.10), transparent 30rem),
    #020817;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

.ftz-admin-app {
  min-height: 100vh;
}

.ftz-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 1040;
  display: flex;
  width: var(--ftz-sidebar);
  flex-direction: column;
  border-right: 1px solid rgba(98, 133, 204, 0.18);
  background:
    linear-gradient(180deg, rgba(2, 8, 25, .97), rgba(1, 7, 22, .98)),
    #020817;
  box-shadow: 24px 0 55px rgba(0, 0, 0, .22);
  overflow: hidden;
}

.ftz-sidebar::before {
  content: "";
  position: absolute;
  inset: 70px 0 0 165px;
  width: 150px;
  opacity: .72;
  background:
    url("/assets/fixtradezone/neo/sidebar-bg.png") center / 150px 620px repeat-y;
  filter: saturate(1.25) brightness(1.15);
  pointer-events: none;
}

.ftz-logo {
  position: relative;
  z-index: 1;
  display: flex;
  height: 82px;
  align-items: center;
  padding: 0 18px;
  text-decoration: none;
}

.ftz-logo img {
  width: 200px;
  height: auto;
}

.ftz-sidebar-nav {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 10px 13px 24px;
  overflow-y: auto;
  scrollbar-width: none;
}

.ftz-sidebar-nav::-webkit-scrollbar {
  display: none;
}

.ftz-nav-section + .ftz-nav-section {
  margin-top: 28px;
}

.ftz-nav-label {
  margin: 0 6px 10px;
  color: #b4c0d7;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
}

.ftz-nav-link {
  display: flex;
  min-height: 45px;
  align-items: center;
  gap: 13px;
  margin: 3px 0;
  padding: 0 14px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: #e4eaf6;
  text-decoration: none;
  font-size: 14px;
  transition: .18s ease;
}

.ftz-nav-link i {
  width: 21px;
  color: #d9e3f4;
  font-size: 20px;
}

.ftz-nav-link:hover:not(.is-disabled) {
  color: #fff;
  border-color: rgba(40, 205, 230, .22);
  background: rgba(14, 55, 83, .46);
  transform: translateX(2px);
}

.ftz-nav-link.is-active {
  color: #25fff0;
  border-color: #11d7cb;
  background:
    linear-gradient(90deg, rgba(3, 119, 130, .52), rgba(26, 233, 202, .22)),
    rgba(7, 46, 68, .72);
  box-shadow:
    inset 0 0 23px rgba(16, 224, 218, .12),
    0 0 20px rgba(13, 221, 213, .17);
}

.ftz-nav-link.is-active i {
  color: #29fff0;
}

.ftz-nav-link.is-disabled {
  color: rgba(220, 229, 245, .85);
  cursor: default;
}

.ftz-sidebar-profile {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px;
  padding: 14px;
  border: 1px solid rgba(43, 132, 238, .38);
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(8, 31, 69, .93), rgba(4, 13, 36, .96));
  box-shadow: inset 0 0 24px rgba(0, 112, 255, .06);
}

.ftz-sidebar-profile strong,
.ftz-sidebar-profile small {
  display: block;
}

.ftz-sidebar-profile strong {
  font-size: 12px;
}

.ftz-sidebar-profile small {
  margin-top: 3px;
  color: var(--ftz-green);
  font-size: 11px;
}

.ftz-profile-shield {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 11px;
  color: #1ffff0;
  background: linear-gradient(145deg, rgba(13, 230, 187, .32), rgba(9, 64, 113, .25));
  box-shadow: 0 0 16px rgba(11, 235, 204, .18);
}

.ftz-sidebar-overlay {
  display: none;
}

.ftz-topbar {
  position: fixed;
  inset: 0 0 auto var(--ftz-sidebar);
  z-index: 1030;
  display: flex;
  min-height: var(--ftz-topbar);
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 0 28px 0 22px;
  border-bottom: 1px solid rgba(80, 122, 189, .26);
  background: rgba(2, 8, 24, .88);
  backdrop-filter: blur(18px);
}

.ftz-topbar-title,
.ftz-topbar-actions,
.ftz-topbar-profile {
  display: flex;
  align-items: center;
}

.ftz-topbar-title {
  gap: 15px;
}

.ftz-topbar-title h1 {
  margin: 0;
  font-size: 20px;
  font-weight: 750;
}

.ftz-topbar-title p {
  margin: 3px 0 0;
  color: #a8b5cb;
  font-size: 12px;
}

.ftz-topbar-actions {
  gap: 10px;
}

.ftz-icon-button {
  position: relative;
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border: 1px solid rgba(85, 124, 185, .34);
  border-radius: 50%;
  color: #e9f2ff;
  background: rgba(6, 16, 39, .74);
  transition: .16s ease;
}

.ftz-icon-button:hover {
  color: #1ffff0;
  border-color: rgba(29, 239, 227, .55);
  background: rgba(7, 42, 58, .82);
  box-shadow: 0 0 20px rgba(24, 231, 219, .12);
}

.ftz-notification span {
  position: absolute;
  top: -4px;
  right: -2px;
  display: grid;
  min-width: 18px;
  height: 18px;
  place-items: center;
  border-radius: 999px;
  color: #fff;
  background: #ff424f;
  font-size: 9px;
  font-weight: 800;
}

.ftz-search {
  position: relative;
  display: flex;
  width: clamp(310px, 28vw, 430px);
  height: 43px;
  align-items: center;
}

.ftz-search > i {
  position: absolute;
  left: 15px;
  color: #dce7f6;
  font-size: 19px;
}

.ftz-search input {
  width: 100%;
  height: 100%;
  padding: 0 78px 0 43px;
  border: 1px solid rgba(97, 130, 188, .34);
  border-radius: 10px;
  outline: 0;
  color: #eef4ff;
  background: rgba(2, 10, 29, .66);
  font-size: 12px;
  transition: .16s ease;
}

.ftz-search input::placeholder {
  color: #8895aa;
}

.ftz-search input:focus {
  border-color: rgba(22, 229, 224, .72);
  box-shadow: 0 0 0 3px rgba(22, 229, 224, .08);
}

.ftz-search kbd {
  position: absolute;
  right: 9px;
  padding: 4px 8px;
  border: 1px solid rgba(125, 146, 185, .28);
  border-radius: 6px;
  color: #b7c2d5;
  background: rgba(255, 255, 255, .03);
  font-size: 9px;
  font-weight: 500;
}

.ftz-topbar-profile {
  gap: 10px;
  margin-left: 4px;
}

.ftz-avatar {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid #4ae5f7;
  border-radius: 50%;
  color: #bafff6;
  background: radial-gradient(circle at 32% 25%, #174f72, #07162f 70%);
  box-shadow: 0 0 18px rgba(42, 211, 236, .12);
  font-size: 15px;
}

.ftz-topbar-profile-copy strong,
.ftz-topbar-profile-copy small {
  display: block;
}

.ftz-topbar-profile-copy strong {
  font-size: 12px;
}

.ftz-topbar-profile-copy small {
  margin-top: 2px;
  color: #a5b3c9;
  font-size: 10px;
}

.ftz-profile-menu {
  border: 0;
  color: #e7effd;
  background: transparent;
}

.ftz-main {
  min-height: 100vh;
  margin-left: var(--ftz-sidebar);
  padding-top: var(--ftz-topbar);
}

.ftz-dashboard {
  position: relative;
  min-height: calc(100vh - var(--ftz-topbar));
  padding: 0 16px 16px;
  background:
    radial-gradient(circle at 45% 25%, rgba(18, 53, 124, .10), transparent 25rem),
    linear-gradient(180deg, rgba(2, 8, 24, .5), rgba(2, 7, 20, .75));
}

.ftz-dashboard::before {
  content: "";
  position: fixed;
  z-index: -1;
  inset: 0;
  opacity: .12;
  background:
    radial-gradient(circle at 10% 75%, rgba(46, 34, 255, .55), transparent 18rem),
    radial-gradient(circle at 44% 18%, rgba(0, 195, 255, .26), transparent 20rem),
    radial-gradient(circle at 86% 78%, rgba(186, 30, 255, .22), transparent 22rem);
  pointer-events: none;
}

.ftz-market-ticker {
  display: flex;
  min-height: 58px;
  align-items: center;
  gap: 0;
  margin: 0 -16px 14px;
  padding: 0 20px;
  border-bottom: 1px solid rgba(73, 119, 189, .22);
  background: rgba(3, 10, 28, .58);
  overflow-x: auto;
  scrollbar-width: none;
}

.ftz-market-ticker::-webkit-scrollbar {
  display: none;
}

.ftz-market-item {
  display: flex;
  min-width: 204px;
  align-items: center;
  gap: 9px;
  padding: 0 15px;
  border-right: 1px solid rgba(72, 103, 157, .28);
}

.ftz-market-item > div {
  min-width: 74px;
}

.ftz-market-item strong,
.ftz-market-item small {
  display: block;
}

.ftz-market-item strong {
  font-size: 10px;
  font-weight: 700;
}

.ftz-market-item small {
  margin-top: 1px;
  color: #e9edf6;
  font-size: 10px;
  font-weight: 700;
}

.ftz-market-item > b {
  color: var(--ftz-green);
  font-size: 10px;
}

.ftz-coin,
.ftz-mini-coin {
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  font-weight: 800;
}

.ftz-coin {
  width: 23px;
  height: 23px;
  flex: 0 0 auto;
  font-size: 10px;
}

.ftz-mini-coin {
  display: inline-grid;
  width: 16px;
  height: 16px;
  margin-right: 3px;
  background: #f49e00;
  font-size: 8px;
}

.ftz-coin-orange,
.ftz-coin-gold {
  background: #f7931a;
}

.ftz-coin-blue {
  background: #4269d7;
}

.ftz-coin-purple {
  background: linear-gradient(#1fe0bd, #7b34ff);
}

.ftz-coin-dark {
  background: #05070b;
  border: 1px solid #5f6b80;
}

.ftz-spark {
  width: 50px;
  height: 24px;
  overflow: visible;
}

.ftz-spark polyline {
  stroke-width: 1.2;
}

.ftz-spark-green polyline { stroke: #12e5a4; }
.ftz-spark-blue polyline { stroke: #3577ff; }
.ftz-spark-orange polyline { stroke: #ff9e00; }
.ftz-spark-purple polyline { stroke: #e241dd; }
.ftz-spark-cyan polyline { stroke: #18e7e3; }

.ftz-dashboard-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 14px;
  max-width: 1460px;
  margin: 0 auto;
}

.ftz-dashboard-primary {
  min-width: 0;
}

.ftz-hero {
  position: relative;
  display: flex;
  min-height: 150px;
  overflow: hidden;
  border: 1px solid rgba(39, 222, 221, .72);
  border-radius: 11px;
  background:
    linear-gradient(90deg, rgba(0, 43, 61, .92) 0%, rgba(4, 35, 71, .78) 43%, rgba(4, 10, 32, .52) 68%),
    #06102a;
  box-shadow: inset 0 0 42px rgba(0, 229, 211, .08);
}

.ftz-hero::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 1px;
  background: linear-gradient(90deg, #11e6d1, transparent 70%);
}

.ftz-hero-copy {
  position: relative;
  z-index: 2;
  width: 56%;
  padding: 18px 25px;
}

.ftz-hero-copy h2 {
  margin: 8px 0 5px;
  font-size: clamp(20px, 2vw, 26px);
  font-weight: 760;
}

.ftz-hero-copy p {
  margin: 0;
  color: #d8e3f6;
  font-size: 12px;
}

.ftz-secure-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 9px;
  border-radius: 999px;
  color: #19f0bd;
  background: rgba(10, 109, 92, .28);
  font-size: 9px;
  font-weight: 700;
}

.ftz-hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 15px;
}

.ftz-hero-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  border: 1px solid rgba(76, 139, 184, .28);
  border-radius: 7px;
  color: #e4edf9;
  background: rgba(0, 14, 36, .48);
  font-size: 9px;
}

.ftz-hero-art {
  position: absolute;
  inset: 0 0 0 auto;
  width: 64%;
  background:
    linear-gradient(90deg, rgba(0, 44, 60, 1) 0%, rgba(0, 44, 60, .14) 23%, rgba(0, 0, 0, 0) 48%),
    url("/assets/fixtradezone/neo/dashboard-bull-banner.png") right center / cover no-repeat;
  filter: saturate(1.05);
}

.ftz-metric-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin-top: 12px;
}

.ftz-metric-card,
.ftz-panel {
  border: 1px solid var(--ftz-line);
  border-radius: 11px;
  background:
    linear-gradient(145deg, rgba(9, 27, 60, .94), rgba(3, 14, 35, .96));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .018);
}

.ftz-metric-card {
  position: relative;
  display: grid;
  min-height: 104px;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 14px;
  overflow: hidden;
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.ftz-metric-card:hover {
  transform: translateY(-3px);
  border-color: rgba(33, 225, 224, .42);
  box-shadow: 0 10px 28px rgba(0, 0, 0, .20), 0 0 22px rgba(0, 206, 220, .06);
}

.ftz-metric-icon {
  display: grid;
  width: 43px;
  height: 43px;
  place-items: center;
  border-radius: 11px;
  font-size: 22px;
}

.ftz-metric-card.is-cyan .ftz-metric-icon {
  color: #1bfff0;
  background: rgba(0, 226, 214, .16);
  box-shadow: 0 0 18px rgba(0, 226, 214, .10);
}

.ftz-metric-card.is-blue .ftz-metric-icon {
  color: #4d75ff;
  background: rgba(61, 92, 255, .16);
}

.ftz-metric-card.is-orange .ftz-metric-icon {
  color: #ffae00;
  background: rgba(255, 157, 0, .15);
}

.ftz-metric-card.is-purple .ftz-metric-icon {
  color: #f24be5;
  background: rgba(213, 44, 224, .15);
}

.ftz-metric-copy small,
.ftz-metric-copy strong,
.ftz-metric-copy span {
  display: block;
}

.ftz-metric-copy small {
  color: #c1cce0;
  font-size: 10px;
}

.ftz-metric-copy strong {
  margin-top: 3px;
  white-space: nowrap;
  font-size: 18px;
}

.ftz-metric-copy span {
  margin-top: 12px;
  white-space: nowrap;
  color: #9aa9c1;
  font-size: 8px;
}

.ftz-metric-copy span b {
  color: var(--ftz-green);
  font-weight: 700;
}

.ftz-mid-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.38fr) minmax(300px, .92fr);
  gap: 12px;
  margin-top: 12px;
}

.ftz-stack {
  display: grid;
  gap: 12px;
}

.ftz-panel {
  padding: 14px;
}

.ftz-panel h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
}

.ftz-panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.ftz-panel-heading button {
  padding: 6px 10px;
  border: 1px solid rgba(91, 125, 180, .35);
  border-radius: 7px;
  color: #dce6f5;
  background: rgba(4, 14, 35, .64);
  font-size: 9px;
}

.ftz-legend {
  display: flex;
  gap: 18px;
  margin-top: 10px;
  color: #aab8cd;
  font-size: 9px;
}

.dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 4px;
  border-radius: 50%;
}

.dot.green { background: var(--ftz-green); }
.dot.purple { background: var(--ftz-purple); }
.dot.blue { background: var(--ftz-blue); }

.ftz-chart-wrap {
  position: relative;
  height: 224px;
  margin-top: 13px;
}

.ftz-trading-chart {
  width: 100%;
  height: 180px;
  overflow: visible;
  cursor: crosshair;
}

.ftz-chart-grid {
  stroke: rgba(112, 143, 193, .16);
  stroke-width: 1;
  stroke-dasharray: 3 4;
}

.ftz-chart-line {
  fill: none;
  stroke-width: 2;
  vector-effect: non-scaling-stroke;
  filter: drop-shadow(0 0 4px rgba(30, 220, 225, .12));
}

.ftz-chart-line.is-green { stroke: #15e6a3; }
.ftz-chart-line.is-purple { stroke: #9f45ff; }
.ftz-chart-line.is-blue { stroke: #367cff; }

.ftz-chart-crosshair {
  stroke: rgba(124, 169, 231, .46);
  stroke-width: 1;
  stroke-dasharray: 3 4;
}

.ftz-chart-tooltip {
  position: absolute;
  top: 10px;
  z-index: 2;
  display: grid;
  min-width: 155px;
  gap: 6px;
  padding: 10px;
  border: 1px solid rgba(75, 119, 181, .34);
  border-radius: 7px;
  background: rgba(4, 14, 34, .94);
  box-shadow: 0 10px 24px rgba(0, 0, 0, .24);
  transform: translateX(-50%);
  pointer-events: none;
}

.ftz-chart-tooltip strong {
  font-size: 9px;
}

.ftz-chart-tooltip span {
  display: grid;
  grid-template-columns: 10px 1fr auto;
  align-items: center;
  color: #dce6f5;
  font-size: 8px;
}

.ftz-chart-tooltip b {
  color: #fff;
}

.ftz-chart-months {
  display: flex;
  justify-content: space-between;
  color: #9ba9be;
  font-size: 8px;
}

.ftz-chart-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 10px;
  border-top: 1px solid rgba(76, 111, 169, .22);
}

.ftz-chart-stats > div {
  padding: 12px 11px 0;
  border-right: 1px solid rgba(76, 111, 169, .17);
}

.ftz-chart-stats > div:last-child {
  border-right: 0;
}

.ftz-chart-stats small,
.ftz-chart-stats strong {
  display: block;
}

.ftz-chart-stats small {
  color: #9ba9c0;
  font-size: 8px;
}

.ftz-chart-stats strong {
  margin-top: 3px;
  font-size: 15px;
}

.ftz-chart-stats span {
  display: inline-block;
  margin-left: 4px;
  color: var(--ftz-green);
  font-size: 8px;
}

.ftz-chart-stats span.purple { color: #d950dd; }
.ftz-chart-stats span.orange { color: #ffb000; }

.ftz-deposit-body {
  display: grid;
  grid-template-columns: 145px 1fr;
  align-items: center;
  gap: 18px;
  min-height: 154px;
}

.ftz-donut {
  display: grid;
  width: 130px;
  height: 130px;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, #07142e 0 43%, transparent 44%),
    conic-gradient(
      #ff9d00 0 35.8%,
      #10cba5 35.8% 64.2%,
      #2a78f6 64.2% 82.9%,
      #ffba00 82.9% 92.7%,
      #755cff 92.7% 100%
    );
  box-shadow: 0 0 24px rgba(60, 74, 255, .10);
  transition: transform .2s ease;
}

.ftz-donut:hover {
  transform: rotate(2deg) scale(1.03);
}

.ftz-donut div {
  text-align: center;
}

.ftz-donut strong,
.ftz-donut small {
  display: block;
}

.ftz-donut strong {
  font-size: 12px;
}

.ftz-donut small {
  margin-top: 2px;
